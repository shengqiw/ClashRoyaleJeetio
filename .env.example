# jeetio environment — copy real values into .env.local (never commit .env.local)
# Everything below is a FREE tier. The $0 rule: no key here may ever have billing attached.
#
# To see which of these the running app actually has: GET /api/health (booleans only,
# never values). The authoritative list is ENV_KEYS in src/app/api/health/route.ts —
# add a var there whenever you add one here, or health lies by omission.

# --- Clash Royale data (primary path) ---
# Supercell developer key: https://developer.clashroyale.com
#   -> create key with allowed IP 45.79.218.79 (the free RoyaleAPI proxy's IP)
SUPERCELL_API_KEY=
# Home clan
CLAN_TAG=PRURJPJP
# Override only if RoyaleAPI ever moves: default https://proxy.royaleapi.dev/v1
# CLASH_PROXY_BASE=

# --- Legacy fallback (optional; delete once AWS is torn down) ---
# Old AWS API Gateway that proxied Supercell. Currently 500s; kept as fallback only.
# CR_API_BASE=https://xgyzcbqe9i.execute-api.us-east-1.amazonaws.com

# --- Free-tier LLM keys (any subset works; the chain skips missing ones) ---
# Groq: https://console.groq.com -> API Keys (free tier, fast)
GROQ_API_KEY=
# Google AI Studio: https://aistudio.google.com/apikey (FREE-tier key, no billing account)
GEMINI_API_KEY=
# OpenRouter: https://openrouter.ai/keys (free models incl. DeepSeek R1; 50 req/day free)
OPENROUTER_API_KEY=

# --- Cosmetic ---
# Shown in server logs at boot; no behavior depends on it.
APP_NAME="Jeetio Clan Website"
