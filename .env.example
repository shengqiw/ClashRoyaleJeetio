# jeetio environment — copy to .env.local and fill in (never commit .env.local).
# `GET /api/health` reports which of these the running app actually sees (booleans
# only, never values). The authoritative list is ENV_KEYS in
# src/app/api/health/route.ts — add a var there whenever you add one here, or
# health lies by omission.

# Backend API that every route under src/app/api/ proxies to.
# Routes call ${API_BASE_URL}/clash/... and ${API_BASE_URL}/intel/...
API_BASE_URL=

# Sent as the `x-api-key` header on every backend call.
API_KEY=
